  simp [decodeUnsigned, outside]

/-- Restore Rustler's panic boundary after the extracted computation has run
its actual cleanup. Captured Err is an exceptional exit, never a Rust return. -/
@[expose] def resumeCaptured {α : Type}
    (computation : RustM (core.result.Result α Unit)) : RustM α := do
  let outcome ← computation
  match outcome with
  | .Ok value => RustM.ok value
  | .Err () => RustM.fail .panic

@[simp] theorem resumeCaptured_ok {α : Type} (value : α) :
    resumeCaptured (RustM.ok (.Ok value)) = RustM.ok value := by
  simp [resumeCaptured]

@[simp] theorem resumeCaptured_panic {α : Type} :
    resumeCaptured (RustM.ok (.Err ()) : RustM (core.result.Result α Unit)) =
      RustM.fail .panic := by
  simp [resumeCaptured]

/-- Observe the extracted computation directly. No implementation result is
assumed or replaced with a handwritten function. Panic models an unwinding
Rustler wrapper; divergence/undefined behaviour is an uncatchable verification
cutoff and cannot establish a successful return. -/
@[expose] def execute {α : Type} (computation : RustM α) (encode : α → Term) : Except Exception Term :=
  match computation.match with
  | .ok value => .ok (encode value)
  | .vis (.fail .panic) _ => .error (.error (.atom "nif_panicked"))
  | _ => .error .exhausted

/-- Staged conversion outcome for supported Rustler errors. Captured encoders
remain unevaluated until return conversion. Rust-side variant inspection and
payload access remain unsupported; this is not the native Error enum layout. -/
inductive DecoderError where
  | ok : Term → DecoderError
  | error : Exception → DecoderError
  | encoded : Bool → (Env → RustM NativeTerm) → DecoderError

/-- Static Rustler Decoder dictionary. First-party methods are extracted bodies;
only catalogued native primitives use reported FFI models. -/
structure Decoder (Self : Type) where
  decode : NativeTerm → RustM (core.result.Result Self DecoderError)

/-- Error payload encoders execute during Rustler return conversion. Panics here
escape the computation's catch_unwind boundary, so they exhaust verification
rather than becoming a catchable nif_panicked result. -/
@[expose] def DecoderError.convert : DecoderError → Except Exception Term
  | .ok value => .ok value
  | .error exception => .error exception
  | .encoded raised encode =>
      match (encode ()).match with
      | .ok value => if raised then .error (.error value) else .ok (.tuple #[.atom "error", value])
      | _ => .error .exhausted

@[simp] theorem DecoderError.convert_ok (value : Term) :
    DecoderError.convert (.ok value) = .ok value := rfl
@[simp] theorem DecoderError.convert_error (error : Exception) :
    DecoderError.convert (.error error) = .error error := rfl

@[expose] def raiseTermErrorOutcome (boxed : Dyn Encoder) : DecoderError :=
  .encoded true (fun env => boxed.inst.encode boxed.value env)

@[expose] def termErrorOutcome (boxed : Dyn Encoder) : DecoderError :=
  .encoded false (fun env => boxed.inst.encode boxed.value env)

theorem raiseTermErrorOutcome_converts {α : Type} (encoder : Encoder α) (value : α)
    (term : Term) (encoded : encoder.encode value () = RustM.ok term) :
    DecoderError.convert (raiseTermErrorOutcome ⟨α, encoder, value⟩) = .error (.error term) := by
  simp [raiseTermErrorOutcome, DecoderError.convert, encoded]

theorem termErrorOutcome_converts {α : Type} (encoder : Encoder α) (value : α)
    (term : Term) (encoded : encoder.encode value () = RustM.ok term) :
    DecoderError.convert (termErrorOutcome ⟨α, encoder, value⟩) = .ok (.tuple #[.atom "error", term]) := by
  simp [termErrorOutcome, DecoderError.convert, encoded]

theorem raiseTermErrorOutcome_panics {α : Type} (encoder : Encoder α) (value : α)
    (panicked : encoder.encode value () = RustM.fail .panic) :
    DecoderError.convert (raiseTermErrorOutcome ⟨α, encoder, value⟩) = .error .exhausted := by
  simp [raiseTermErrorOutcome, DecoderError.convert, panicked]

/-- The conversion outcome of the validated zero-field Rustler BadArg constructor.
Other constructors and Error inspection require separate admitted semantics. -/
@[expose] def badArgOutcome : DecoderError := .error (.error (.atom "badarg"))

/-- Error construction stores an outcome; Rustler converts it only on return.
Atom creation and allocation success remain assumptions at the native FFI boundary. -/
@[expose] def atomErrorOutcome (value : String) : DecoderError := .ok (.atom value)
@[expose] def raiseAtomErrorOutcome (value : String) : DecoderError := .error (.error (.atom value))

namespace Decoding

/-- Model of Rustler get_tuple: preserve field order and report BadArg for
non-tuples. Oversized logical tuples exhaust verification. Native handles,
vector allocation and the Rustler/NIF implementation remain trusted boundaries. -/
@[expose] def getTuple (term : NativeTerm) :
    RustM (core.result.Result (alloc.vec.Vec NativeTerm) DecoderError) :=
  match term with
  | .tuple fields =>
    if bounds : fields.toList.length ≤ Usize.max ∧ fields.toList.length ≤ Isize.max.toNat ∧
        fields.toList.length ≤ 16777215 then
      .ok (.Ok (alloc.vec.Vec.from fields.toList bounds.1))
    else .fail .undef
  | _ => .ok (.Err badArgOutcome)

theorem getTuple_fields (fields : Array Term)
    (bounds : fields.toList.length ≤ Usize.max ∧ fields.toList.length ≤ Isize.max.toNat ∧
      fields.toList.length ≤ 16777215) :
    getTuple (.tuple fields) = .ok (.Ok (alloc.vec.Vec.from fields.toList bounds.1)) := by
  simp only [Array.length_toList] at bounds
  simp [getTuple, bounds]

theorem getTuple_not_tuple (term : Term) (notTuple : ∀ fields, term ≠ .tuple fields) :
    getTuple term = .ok (.Err badArgOutcome) := by
  cases term <;> simp_all [getTuple]

theorem getTuple_exhausted (fields : Array Term)
    (outside : ¬ (fields.toList.length ≤ Usize.max ∧ fields.toList.length ≤ Isize.max.toNat ∧
      fields.toList.length ≤ 16777215)) :
    getTuple (.tuple fields) = .fail .undef := by
  simp only [Array.length_toList] at outside
  simp [getTuple, outside]

@[expose] def u64 (term : NativeTerm) : RustM (core.result.Result U64 DecoderError) :=
  .ok (match decodeUnsigned .U64 64 term with
    | .ok value => .Ok value
    | .error error => .Err (.error error))

/-- Rustler can return or raise from a decoding error before later arguments
or the NIF body execute. Observe the actual extracted Decoder, including panic
and verification exhaustion, then continue only on successful decoding. -/
@[expose] def withDecoded {α : Type}
    (computation : RustM (core.result.Result α DecoderError))
    (continuation : α → Except Exception Term) : Except Exception Term :=
  match computation.match with
  | .ok (.Ok value) => continuation value
  | .ok (.Err returned) => returned.convert
  | .vis (.fail .panic) _ => .error (.error (.atom "nif_panicked"))
  | _ => .error .exhausted

theorem withDecoded_ok {α : Type} (value : α) (continuation : α → Except Exception Term) :
    withDecoded (RustM.ok (.Ok value)) continuation = continuation value := by simp [withDecoded]

theorem withDecoded_error {α : Type} (returned : DecoderError)
    (continuation : α → Except Exception Term) :
    withDecoded (RustM.ok (.Err returned)) continuation = returned.convert := by simp [withDecoded]

end Decoding

@[simp] theorem execute_ok {α : Type} (value : α) (encode : α → Term) :
    execute (RustM.ok value) encode = .ok (encode value) := by
  simp [execute]

@[simp] theorem execute_panic {α : Type} (encode : α → Term) :
    execute (RustM.fail .panic) encode = .error (.error (.atom "nif_panicked")) := by
  simp [execute]

@[simp] theorem execute_div {α : Type} (encode : α → Term) :
    execute (RustM.div : RustM α) encode = .error .exhausted := by
  simp [execute]

@[simp] theorem execute_undef {α : Type} (encode : α → Term) :
    execute (RustM.fail .undef : RustM α) encode = .error .exhausted := by
  simp [execute]

/-- Transport a total Rust property to the term execution model. -/
theorem execute_of_spec {α : Type} {computation : RustM α} {post : α → Prop}
    (verified : WP.spec computation post) (encode : α → Term) :
    ∃ value, post value ∧ execute computation encode = .ok (encode value) := by
  cases computation with
  | ret value => exact ⟨value, WP.spec_ok value |>.mp verified, execute_ok value encode⟩
  | vis effect continuation => simp at verified
  | div => simp at verified

end Lynx.Rustler
