opam-version: "2.0"
name: "aeneas"
version: "0.1"
synopsis: "Compiler from Rust to pure code"
authors: ["Son Ho" "Jonathan Protzenko" "Aymeric Fromherz" "Sidney Congard"]
license: "Apache-2.0"
homepage: "https://github.com/AeneasVerif/aeneas"
bug-reports: "https://github.com/AeneasVerif/aeneas/issues"
depends: [
  "astring" {= "0.8.5" & with-test}
  "backoff" {= "0.1.1"}
  "base" {= "v0.17.3" & with-test}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "calendar" {= "3.0.0"}
  "camlp-streams" {= "5.0.1" & with-test}
  "cmdliner" {= "1.3.0"}
  "conf-gmp" {= "5"}
  "conf-pkg-config" {= "5"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2" & with-test}
  "domain-local-await" {= "1.0.1"}
  "domainslib" {= "0.5.2"}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2" & with-test}
  "dune-configurator" {= "3.24.2" & with-test}
  "easy_logging" {= "0.8.2"}
  "either" {= "1.0.0" & with-test}
  "fix" {= "20250919" & with-test}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3" & with-test}
  "logs" {= "0.10.0"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "mtime" {= "2.2.0"}
  "multicore-magic" {= "2.3.2"}
  "ocaml" {= "5.3.0"}
  "ocaml-base-compiler" {= "5.3.0"}
  "ocaml-compiler" {= "5.3.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-version" {= "4.1.5" & with-test}
  "ocaml_intrinsics_kernel" {= "v0.17.3" & with-test}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "ocamlformat" {= "0.27.0" & with-test}
  "ocamlformat-lib" {= "0.27.0" & with-test}
  "ocamlgraph" {= "2.2.0"}
  "ocp-indent" {= "1.9.0" & with-test}
  "optint" {= "0.3.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppx_deriving_yojson" {= "3.10.0"}
  "ppxlib" {= "0.39.0"}
  "progress" {= "0.5.0"}
  "re" {= "1.14.0"}
  "result" {= "1.5"}
  "saturn" {= "1.0.0"}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0" & with-test}
  "stdlib-shims" {= "0.3.0"}
  "terminal" {= "0.5.0"}
  "thread-table" {= "1.0.0"}
  "topkg" {= "1.1.1"}
  "unionFind" {= "20250818"}
  "uucp" {= "18.0.0"}
  "uuseg" {= "18.0.0" & with-test}
  "uutf" {= "1.0.4"}
  "visitors" {= "20260520"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/AeneasVerif/aeneas.git"