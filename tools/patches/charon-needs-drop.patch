diff --git a/charon/tests/crate_data.rs b/charon/tests/crate_data.rs
index 9c9115671cd9..3250ac2517d3 100644
--- a/charon/tests/crate_data.rs
+++ b/charon/tests/crate_data.rs
@@ -1244 +1244,24 @@ fn reuses_default_only_for_default_copies() -> anyhow::Result<()> {
 }
+
+#[test]
+fn needs_drop() -> anyhow::Result<()> {
+    let crate_data = translate(
+        r#"
+        struct Plain { value: u64 }
+        struct Custom { value: u64 }
+        impl Drop for Custom { fn drop(&mut self) {} }
+        struct Nested { inner: Custom }
+        struct Generic<T> { value: T }
+        fn main() {}
+        "#,
+    )?;
+    let queries: HashMap<_, _> = user_type_decls(&crate_data)
+        .into_iter()
+        .map(|decl| (decl.item_meta.name.debug_repr(&crate_data), decl.needs_drop))
+        .collect();
+    assert_eq!(queries["test_crate::Plain"], Some(false));
+    assert_eq!(queries["test_crate::Custom"], Some(true));
+    assert_eq!(queries["test_crate::Nested"], Some(true));
+    assert_eq!(queries["test_crate::Generic"], None);
+    Ok(())
+}
