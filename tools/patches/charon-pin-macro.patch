+        for block in body.basic_blocks.as_mut() {
+            let terminator = block.terminator.as_mut().unwrap();
+            let mir::TerminatorKind::Call {
+                func,
+                args,
+                destination,
+                target: Some(target),
+                ..
+            } = &terminator.kind
+            else {
+                continue;
+            };
+            let ty::FnDef(id, _) = func.ty(&body.local_decls, tcx).kind() else {
+                continue;
+            };
+            if tcx.item_name(*id).as_str() != "pin_new_unchecked_in_helper"
+                || tcx.parent(*id) != tcx.parent(wrapper_id)
+                || args.len() != 1
+                || !terminator
+                    .source_info
+                    .span
+                    .macro_backtrace()
