+            }
+            let place = match &args[0].node {
+                mir::Operand::Move(place) | mir::Operand::Copy(place) => *place,
+                _ => continue,
+            };
+            let projected = place.project_deeper(
+                &[
+                    mir::ProjectionElem::Deref,
+                    mir::ProjectionElem::Field(rustc_abi::FieldIdx::from_usize(0), payload),
+                ],
+                tcx,
+            );
+            let fresh = body.local_decls.push(mir::LocalDecl::new(
+                output_pointer,
+                terminator.source_info.span,
+            ));
+            let mut borrowed = (*borrow).clone();
+            borrowed.source_info = terminator.source_info;
+            borrowed.kind = mir::StatementKind::Assign(Box::new((
+                mir::Place::from(fresh),
+                mir::Rvalue::Ref(
+                    *region,
+                    mir::BorrowKind::Mut {
+                        kind: mir::MutBorrowKind::Default,
+                    },
+                    projected,
+                ),
+            )));
+            let mut constructed = (*construct).clone();
+            constructed.source_info = terminator.source_info;
+            constructed.kind = mir::StatementKind::Assign(Box::new((
+                *destination,
+                mir::Rvalue::Aggregate(
+                    Box::new(mir::AggregateKind::Adt(
+                        pin_id,
+                        rustc_abi::VariantIdx::from_usize(0),
+                        pin_args,
+                        None,
+                        None,
+                    )),
+                    rustc_index::IndexVec::from_raw(vec![mir::Operand::Move(mir::Place::from(
+                        fresh,
+                    ))]),
+                ),
+            )));
+            block.statements.push(borrowed);
+            block.statements.push(constructed);
+            terminator.kind = mir::TerminatorKind::Goto { target: *target };
+        }
+    }
