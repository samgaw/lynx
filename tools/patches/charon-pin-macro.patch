+#[test]
+fn pin_macro_links_actual_coroutine_poll_and_structural_drop() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--preset=aeneas --cancelling-futures --suspending-futures --immediate-futures --owned-drops --mir=optimized --sysroot=default --start-from=crate::drive --start-from=crate::direct --opaque=core --opaque=std --include=core::pin --include=core::task::poll::Poll --include=core::option::Option --monomorphize-mut=all
+//@ rustc-args=--edition=2024 -Zmir-strip-debuginfo=all-locals -Zmir-enable-passes=+DeadStoreElimination-final,+SimplifyLocals-final
+#![feature(pin_macro_internals)]
+pub async fn make(mutex: std::sync::Mutex<u64>) { drop(mutex); }
+pub fn drive(mutex: std::sync::Mutex<u64>, context: &mut std::task::Context<'_>) -> std::task::Poll<()> {
+    use std::future::Future;
+    std::pin::pin!(make(mutex)).poll(context)
+}
+pub fn direct<T>(wrapper: &mut std::pin::PinMacroHelper<T>) -> std::pin::Pin<&mut T> {
+    unsafe { std::pin::pin_new_unchecked_in_helper(wrapper) }
+}
+fn main() {}
