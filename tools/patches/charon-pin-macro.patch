+    )?;
+    let find = |name: &str| {
+        data.fun_decls
+            .iter()
+            .find(|f| f.item_meta.name.debug_repr(&data) == name)
+            .unwrap()
+    };
+    let calls = |name: &str| {
+        find(name)
+            .body
+            .as_structured()
+            .unwrap()
+            .body
+            .statements
+            .iter()
+            .filter_map(|s| {
+                let StatementKind::Call { call, .. } = &s.kind else {
+                    return None;
+                };
+                let FnOperand::Regular(pointer) = &call.func else {
+                    panic!("direct call required")
+                };
+                let FnPtrKind::Fun(id) = pointer.kind.as_ref() else {
+                    panic!("implementation required, not builtin trait placeholder")
+                };
+                Some(data.fun_decls[*id].item_meta.name.debug_repr(&data))
+            })
+            .collect::<Vec<_>>()
+    };
+    let drive = calls("test_crate::drive");
+    assert!(
+        drive
+            .iter()
+            .any(|n| n.starts_with("test_crate::make::") && n.ends_with("::poll"))
+    );
+    assert!(
+        drive
+            .iter()
+            .any(|n| n.starts_with("test_crate::make::") && n.ends_with("::drop_owned"))
+    );
+    assert!(
+        !drive
+            .iter()
+            .any(|n| n.contains("pin_new_unchecked_in_helper"))
+    );
+    let direct = calls("test_crate::direct");
+    assert!(
+        direct
