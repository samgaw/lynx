+    /// Reproduce the standard pin! helper only at its compiler macro expansion.
+    /// Ordinary unsafe helper calls retain their original verification boundary.
+    fn normalize_pin_macro_calls(&self, body: &mut mir::Body<'tcx>) {
+        if !self.options.immediate_futures {
+            return;
+        }
+        let tcx = self.tcx;
+        let Some(macro_id) = tcx.get_diagnostic_item(Symbol::intern("pin_macro")) else {
+            return;
+        };
+        let Some(wrapper_id) = tcx.get_diagnostic_item(Symbol::intern("PinMacroHelper")) else {
+            return;
+        };
