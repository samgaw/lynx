+            let ty::Ref(_, wrapper_ty, rustc_hir::Mutability::Mut) = pointer.kind() else {
+                continue;
+            };
+            let ty::Adt(wrapper, wrapper_args) = wrapper_ty.kind() else {
+                continue;
+            };
+            if wrapper.did() != wrapper_id
+                || wrapper.variants().len() != 1
+                || wrapper.non_enum_variant().fields.len() != 1
+            {
+                continue;
+            }
+            let payload = wrapper.non_enum_variant().fields[rustc_abi::FieldIdx::from_usize(0)]
+                .ty(tcx, wrapper_args)
+                .skip_normalization();
+            let ty::Adt(pin, pin_args) = destination.ty(&body.local_decls, tcx).ty.kind() else {
+                continue;
+            };
+            if pin.did() != pin_id {
+                continue;
+            }
+            let output_pointer = pin_args.type_at(0);
+            let ty::Ref(region, pointee, rustc_hir::Mutability::Mut) = output_pointer.kind() else {
+                continue;
+            };
+            if *pointee != payload {
+                continue;
+            }
+            let implementation = tcx.optimized_mir(*id);
+            if implementation.arg_count != 1 || implementation.basic_blocks.len() != 1 {
+                continue;
+            }
+            let entry = &implementation.basic_blocks[mir::START_BLOCK];
+            if !matches!(entry.terminator().kind, mir::TerminatorKind::Return) {
+                continue;
+            }
+            let statements: Vec<_> = entry
+                .statements
+                .iter()
+                .filter(|statement| {
+                    !matches!(
+                        statement.kind,
+                        mir::StatementKind::StorageLive(_)
+                            | mir::StatementKind::StorageDead(_)
+                            | mir::StatementKind::Nop
+                    )
+                })
+                .collect();
+            let [borrow, construct] = statements.as_slice() else {
+                continue;
+            };
+            let mir::StatementKind::Assign((
+                borrow_dest,
+                mir::Rvalue::Ref(_, mir::BorrowKind::Mut { .. }, source),
+            )) = &borrow.kind
+            else {
+                continue;
+            };
+            if !borrow_dest.projection.is_empty()
+                || borrow_dest.local.as_usize() <= 1
+                || source.local.as_usize() != 1
+                || !matches!(source.projection.as_ref(),
+                    [mir::ProjectionElem::Deref, mir::ProjectionElem::Field(field, _)] if field.as_usize() == 0)
+            {
+                continue;
+            }
+            let mir::StatementKind::Assign((result, mir::Rvalue::Aggregate(kind, values))) =
+                &construct.kind
+            else {
+                continue;
+            };
+            if result.local != mir::RETURN_PLACE
+                || !result.projection.is_empty()
