+                    if matches!(place.projection.first(), Some(mir::ProjectionElem::Deref)) {
+                        *place = mir::Place::from(place.local)
+                            .project_deeper(&place.projection[1..], self.tcx);
+                    } else {
+                        self.invalid = true;
+                    }
+                }
+            }
+        }
+        let mut visitor = OwnedSelf {
+            tcx: self.tcx,
+            invalid: false,
+        };
+        visitor.visit_body(&mut body);
+        if visitor.invalid {
+            raise_error!(
+                self,
+                span,
+                "Compiler coroutine destruction observes or escapes its self pointer"
+            );
+        }
+        body.local_decls[mir::Local::from_usize(1)].ty = coroutine.self_ty;
+        let layout_body = self.get_mir(def.this(), span)?.unwrap();
+        let Some(layout) = layout_body.coroutine_layout_raw() else {
+            raise_error!(
+                self,
+                span,
+                "Missing compiler coroutine layout for destruction"
