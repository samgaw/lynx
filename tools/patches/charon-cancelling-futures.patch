+    /// Moving a saved payload empties its logical slot; no partially initialized
+    /// record is returned through a future's mutable borrow.
+    fn take_saved_operand(
+        &mut self,
+        span: Span,
+        source: &mir::Place<'tcx>,
+    ) -> Result<Operand, Error> {
+        let (slot, saved) = self.translate_place_inner(span, source, true)?;
+        if !saved {
+            return Ok(Operand::Move(slot));
+        }
+        let rust_ty = source.ty(self.local_decls, self.tcx).ty;
+        let payload = self.translate_rustc_ty(span, &rust_ty)?;
+        let place = self.require_saved_field(span, slot.clone(), payload.clone());
+        if hax::solve_copy(&self.hax_state, rust_ty).is_some() {
+            return Ok(Operand::Copy(place));
+        }
+        // Move the whole slot out through a mutable borrow using the existing
+        // Aeneas replacement primitive, then unwrap the owned previous slot.
+        // A direct move through &mut would leave an uninitialized borrowed field.
+        let option = self.tcx.lang_items().option_type().unwrap();
+        let option_ty = ty::Ty::new_adt(
+            self.tcx,
+            self.tcx.adt_def(option),
+            self.tcx.mk_args(&[rust_ty.into()]),
+        );
+        let borrow_ty = Ty::new(TyKind::Ref(Region::Erased, slot.ty().clone(), RefKind::Mut));
+        let borrow = self.rval_to_place(
+            Rvalue::Ref {
+                place: slot.clone(),
+                kind: BorrowKind::Mut,
+                ptr_metadata: Self::missing_ptr_metadata(),
+            },
+            borrow_ty,
+        );
+        let empty = self.rval_to_place(
+            Rvalue::Aggregate(
+                AggregateKind::Adt(
+                    slot.ty().as_adt().unwrap().clone(),
+                    Some(VariantId::ZERO),
+                    None,
+                ),
+                vec![],
+            ),
+            slot.ty().clone(),
+        );
+        let previous = self.fresh_var(None, slot.ty().clone());
+        let path = NamePattern::parse("core::mem::replace").unwrap();
+        let def_id = self.resolve_single_path(span, &path)?;
+        let args = self.tcx.mk_args(&[option_ty.into()]);
+        let item = hax::ItemRef::translate(self.hax_state_with_id(), def_id, args);
+        let func =
+            FnOperand::Regular(self.translate_fn_ptr(span, &item, TransItemSourceKind::Fun)?);
+        self.push_nounwind_call(
+            span,
+            previous.clone(),
+            Call {
+                func,
+                args: vec![Operand::Move(borrow), Operand::Move(empty)],
+                safety: CallSafety::Inherit,
+            },
+        );
+        let value = self.require_saved_field(span, previous, payload);
+        Ok(Operand::Move(value))
+    }
