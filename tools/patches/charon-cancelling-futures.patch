+            tcx: ty::TyCtxt<'tcx>,
+            invalid: bool,
+        }
+        impl<'tcx> MutVisitor<'tcx> for OwnedSelf<'tcx> {
+            fn tcx(&self) -> ty::TyCtxt<'tcx> {
+                self.tcx
+            }
