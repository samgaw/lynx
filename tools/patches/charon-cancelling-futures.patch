+            let state_ty = Ty::new(TyKind::Scalar(ScalarTy::Integer(IntegerTy::Unsigned(
+                UIntTy::U32,
+            ))));
+            let state = body.locals.place_for_var(LocalId::new(1)).project(
+                ProjectionElem::Field(None, FieldId::new(coroutine.upvar_tys.len())),
+                state_ty,
+            );
