+
+#[test]
+fn owned_future_capture_uses_initial_slot_and_compiler_drop() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--preset=aeneas --cancelling-futures --suspending-futures --immediate-futures --mir=optimized --sysroot=default --start-from=crate::owned --opaque=core --opaque=std --include=core::pin --include=core::task::poll::Poll --include=core::option::Option --monomorphize-mut=all
+//@ rustc-args=--edition=2024 -Zmir-strip-debuginfo=all-locals -Zmir-enable-passes=+DeadStoreElimination-final,+SimplifyLocals-final
+pub async fn owned(mutex: std::sync::Mutex<u64>) { drop(mutex); }
+fn main() {}
+"#,
+    )?;
+    let future = data
+        .type_decls
+        .iter()
+        .find(|decl| {
+            decl.item_meta
+                .name
+                .debug_repr(&data)
+                .starts_with("test_crate::owned::")
+        })
+        .expect("compiler future type");
+    let TypeDeclKind::Struct(fields) = &future.kind else {
+        panic!("concrete future")
+    };
+    assert_eq!(fields[0].name, "capture_0");
+    assert!(
+        fields[0]
+            .ty
+            .with_ctx(&data.into_fmt())
+            .to_string()
+            .contains("Option")
+    );
+    let evidence = future
+        .item_meta
+        .attr_info
+        .attributes
+        .iter()
+        .find_map(|attribute| match attribute {
+            Attribute::Unknown(raw) if raw.path == "lynx::coroutine_storage_v2" => {
+                Some(raw.args.as_ref().unwrap())
+            }
+            _ => None,
+        })
+        .expect("initial capture storage evidence");
+    let metadata: serde_json::Value = serde_json::from_str(evidence)?;
+    assert_eq!(
+        metadata,
+        serde_json::json!({"state": 1, "states": [[0], [], []]})
+    );
+    let drop = data
+        .fun_decls
+        .iter()
+        .find(|decl| {
+            decl.item_meta
+                .name
+                .debug_repr(&data)
+                .ends_with("::drop_owned")
+        })
+        .expect("compiler cancellation implementation");
+    assert_eq!(drop.signature.inputs.len(), 1);
+    let body = drop.body.as_structured().expect("actual drop MIR");
+    assert!(
+        body.body
+            .statements
+            .iter()
+            .any(|statement| matches!(statement.kind, StatementKind::Switch { .. }))
+    );
+    Ok(())
+}
