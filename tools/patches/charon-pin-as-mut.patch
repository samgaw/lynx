+#[test]
+fn pin_as_mut_reborrows_only_standard_mutable_references() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--preset=aeneas --cancelling-futures --suspending-futures --immediate-futures --owned-drops --mir=optimized --sysroot=default --start-from=crate::drive --start-from=crate::custom --start-from=crate::shadow --opaque=core --opaque=std --include=core::pin --include=core::task::poll::Poll --include=core::option::Option --monomorphize-mut=all
+//@ rustc-args=--edition=2024 -Zmir-strip-debuginfo=all-locals -Zmir-enable-passes=+DeadStoreElimination-final,+SimplifyLocals-final
+pub async fn make(mutex: std::sync::Mutex<u64>) { drop(mutex); }
+pub fn drive(mutex: std::sync::Mutex<u64>, context: &mut std::task::Context<'_>) -> std::task::Poll<()> {
+    use std::future::Future;
+    let mut future = std::pin::pin!(make(mutex));
+    future.as_mut().poll(context)
+}
+pub struct Custom<'a>(&'a mut u64);
+impl std::ops::Deref for Custom<'_> { type Target=u64; fn deref(&self)->&u64 { self.0 } }
+impl std::ops::DerefMut for Custom<'_> { fn deref_mut(&mut self)->&mut u64 { self.0 } }
+pub fn custom(mut pointer: std::pin::Pin<Custom<'_>>) { let _ = pointer.as_mut(); }
+pub struct Shadow;
+impl Shadow { pub fn as_mut(&mut self) -> bool { false } }
+pub fn shadow(value: &mut Shadow)->bool { value.as_mut() }
+fn main() {}
