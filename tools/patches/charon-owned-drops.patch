+
+#[test]
+fn owned_drop_entry_retains_compiler_field_cleanup() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--preset=aeneas --owned-drops --mir=optimized --sysroot=default --opaque=core --opaque=std --start-from=crate::make
+pub struct Payload { pub mutex: std::sync::Mutex<u64> }
+pub fn make(value: u64) -> Payload { Payload { mutex: std::sync::Mutex::new(value) } }
+fn main() {}
+"#,
+    )?;
+    let drop = data
+        .fun_decls
+        .iter()
+        .find(|decl| decl.item_meta.name.debug_repr(&data) == "test_crate::Payload::drop_owned")
+        .expect("owning drop entry");
+    assert!(drop.item_meta.started_from);
+    assert_eq!(drop.signature.inputs.len(), 1);
+    assert!(!drop.signature.is_unsafe);
+    let TyKind::Adt(input) = drop.signature.inputs[0].kind() else {
+        panic!("drop must consume an ADT, not a pointer");
+    };
+    assert_eq!(input.generics.types.len(), 0);
+    let body = drop
+        .body
+        .as_structured()
+        .expect("actual compiler drop body");
+    assert_eq!(body.locals.arg_count, 1);
+    assert!(body.body.statements.iter().any(|statement| matches!(
+        &statement.kind, StatementKind::Drop { kind: DropKind::Precise, place, .. }
+            if matches!(&place.kind, PlaceKind::Projection(base, ProjectionElem::Field(None, field))
+                if base.kind == PlaceKind::Local(LocalId::new(1)) && *field == FieldId::new(0))
+    )));
+    assert!(data.ordered_decls.as_ref().expect("ordered declarations").iter().any(|group| {
+        matches!(group, DeclarationGroup::Fun(GDeclarationGroup::NonRec(id)) if *id == drop.def_id)
+    }));
+    Ok(())
+}
