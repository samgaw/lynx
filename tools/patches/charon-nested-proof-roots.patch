@@ -0,0 +1,20 @@
+# Final LLBC before serialization:
+
+// Full name: test_crate::_::INVENTORY::nif_func::wrapper::{closure}::compute
+fn compute(value: bool) -> bool
+{
+    let _0: bool; // return
+    let value: bool; // arg #1
+    let _2: bool; // anonymous local
+
+    storage_live(_0)
+    storage_live(_2)
+    _2 = copy value
+    _0 = ~(move _2)
+    storage_dead(_2)
+    storage_dead(value)
+    return
+}
+
+
+
