+//@ charon-arg=--start-from=crate::_::INVENTORY::nif_func::wrapper::_::compute
+
+const _: () = {
+    static INVENTORY: fn(bool) -> bool = {
+        fn nif_func(value: bool) -> bool {
+            fn wrapper(value: bool) -> bool {
+                (move || {
+                    fn compute(value: bool) -> bool {
+                        !value
+                    }
+                    compute(value)
+                })()
+            }
+            wrapper(value)
+        }
+        nif_func
+    };
+};
