@@ -18,6 +18,29 @@ let backend_of_string (b : string) : backend option =

 let opt_backend : backend option ref = ref None

+(** Optional result monad for effectful Lean models. The target module provides
+    [ok], [fail], [massert] and [lift]; standard RustM calls require a MonadLift. *)
+let lean_result_monad : string option ref = ref None
+
+let set_lean_result_monad (name : string) : unit =
+  let identifier part =
+    String.length part > 0
+    && (match part.[0] with 'a' .. 'z' | 'A' .. 'Z' | '_' -> true | _ -> false)
+    && String.for_all
+         (function 'a' .. 'z' | 'A' .. 'Z' | '0' .. '9' | '_' -> true | _ -> false)
+         part
+  in
+  if not (List.for_all identifier (String.split_on_char '.' name)) then
+    raise (Arg.Bad "-lean-result-monad expects a dotted Lean identifier");
+  lean_result_monad := Some name
+
+let lean_result_name () = Option.value !lean_result_monad ~default:"RustM"
+
+let lean_result_operation (fallback : string) (operation : string) =
+  match !lean_result_monad with
+  | None -> fallback
+  | Some name -> name ^ "." ^ operation
+
 let set_backend (b : string) : unit =
   match backend_of_string b with
   | Some b -> opt_backend := Some b
