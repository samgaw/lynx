+#[test]
+fn safe_pin_new_inlines_only_the_checked_standard_constructor() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--preset=aeneas --immediate-futures --mir=optimized --sysroot=default --start-from=crate::make_pin --start-from=crate::make_shadow --opaque=core --opaque=std --include=core::pin --monomorphize-mut=all
+pub fn make_pin(value: &mut u64) -> std::pin::Pin<&mut u64> { std::pin::Pin::new(value) }
+pub struct Shadow<'a> { value: &'a mut u64 }
+impl<'a> Shadow<'a> {
+    #[inline(never)] pub fn new(value: &'a mut u64) -> Self { Self { value } }
+}
+pub fn make_shadow(value: &mut u64) -> Shadow<'_> { Shadow::new(value) }
+fn main() {}
+"#,
+    )?;
+    let by_name = |name: &str| {
+        data.fun_decls
+            .iter()
+            .find(|f| f.item_meta.name.debug_repr(&data) == name)
+            .unwrap()
+    };
+    let pin = by_name("test_crate::make_pin")
+        .body
+        .as_structured()
+        .unwrap();
+    assert!(pin.body.statements.iter().any(|s| matches!(&s.kind,
+        StatementKind::Assign(_, Rvalue::Aggregate(AggregateKind::Adt(_, None, None), args)) if args.len() == 1)));
+    assert!(
+        !pin.body
+            .statements
+            .iter()
+            .any(|s| matches!(&s.kind, StatementKind::Call { .. }))
+    );
+    let shadow = by_name("test_crate::make_shadow")
+        .body
+        .as_structured()
+        .unwrap();
+    assert!(
+        shadow
+            .body
+            .statements
+            .iter()
+            .any(|s| matches!(&s.kind, StatementKind::Call { .. }))
+    );
+    Ok(())
+}
