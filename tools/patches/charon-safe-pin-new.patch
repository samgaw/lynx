+    /// Inline only safe standard Pin::new calls on mutable Unpin references.
+    /// Check the entire current compiler implementation before reusing its
+    /// one-field constructor; no Deref specification or unsafe helper is admitted.
+    fn normalize_safe_pin_calls(&self, body: &mut mir::Body<'tcx>) {
+        if !self.options.immediate_futures {
+            return;
+        }
+        use crate::hax::UnderOwnerState;
+        let tcx = self.tcx;
+        let pin = tcx.lang_items().pin_type().unwrap();
+        for block in body.basic_blocks.as_mut() {
+            let terminator = block.terminator.as_mut().unwrap();
+            let mir::TerminatorKind::Call {
+                func,
+                args,
+                destination,
+                target: Some(target),
+                ..
+            } = &terminator.kind
+            else {
+                continue;
+            };
+            let ty::FnDef(id, _) = func.ty(&body.local_decls, tcx).kind() else {
+                continue;
+            };
+            if tcx.item_name(*id).as_str() != "new"
+                || args.len() != 1
+                || tcx.fn_sig(*id).skip_binder().safety().is_unsafe()
+            {
+                continue;
+            }
+            let Some(parent) = tcx.impl_of_assoc(*id) else {
+                continue;
+            };
+            let parent_ty = tcx
+                .type_of(parent)
+                .instantiate_identity()
+                .skip_normalization();
+            let ty::Adt(parent, _) = parent_ty.kind() else {
+                continue;
+            };
+            if parent.did() != pin {
+                continue;
+            }
+            let pointer = args[0].node.ty(&body.local_decls, tcx);
+            let ty::Ref(_, pointee, rustc_hir::Mutability::Mut) = pointer.kind() else {
+                continue;
+            };
+            if !pointee.is_unpin(tcx, self.hax_state.typing_env()) {
+                continue;
+            }
+            let ty::Adt(output, generics) = destination.ty(&body.local_decls, tcx).ty.kind() else {
+                continue;
+            };
+            if output.did() != pin || generics.type_at(0) != pointer {
+                continue;
+            }
+            let implementation = tcx.optimized_mir(*id);
+            if implementation.arg_count != 1 || implementation.basic_blocks.len() != 1 {
+                continue;
+            }
+            let entry = &implementation.basic_blocks[mir::START_BLOCK];
+            if !matches!(entry.terminator().kind, mir::TerminatorKind::Return) {
+                continue;
+            }
+            let statements: Vec<_> = entry
+                .statements
+                .iter()
+                .filter(|statement| {
+                    !matches!(
+                        statement.kind,
+                        mir::StatementKind::StorageLive(_)
+                            | mir::StatementKind::StorageDead(_)
+                            | mir::StatementKind::Nop
+                    )
+                })
+                .collect();
+            let [statement] = statements.as_slice() else {
+                continue;
+            };
+            let mir::StatementKind::Assign((dest, mir::Rvalue::Aggregate(kind, values))) =
+                &statement.kind
+            else {
+                continue;
+            };
+            if dest.local != mir::RETURN_PLACE
+                || !dest.projection.is_empty()
+                || !matches!(kind.as_ref(), mir::AggregateKind::Adt(id, _, args, _, _)
+                    if *id == pin && args.type_at(0) == implementation.local_decls[mir::Local::from_usize(1)].ty)
+                || values.len() != 1
+                || !matches!(&values[rustc_abi::FieldIdx::from_usize(0)],
+                    mir::Operand::Copy(place) | mir::Operand::Move(place)
+                    if place.local.as_usize() == 1 && place.projection.is_empty())
+            {
+                continue;
+            }
+            let mut inlined = (*statement).clone();
+            inlined.source_info = terminator.source_info;
+            inlined.kind = mir::StatementKind::Assign(Box::new((
+                *destination,
+                mir::Rvalue::Aggregate(
+                    Box::new(mir::AggregateKind::Adt(
+                        pin,
+                        rustc_abi::VariantIdx::from_usize(0),
+                        generics,
+                        None,
+                        None,
+                    )),
+                    rustc_index::IndexVec::from_raw(vec![args[0].node.clone()]),
+                ),
+            )));
+            block.statements.push(inlined);
+            terminator.kind = mir::TerminatorKind::Goto { target: *target };
         }
     }

