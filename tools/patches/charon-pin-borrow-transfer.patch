+#[test]
+fn pin_get_mut_transfers_only_the_standard_wrapper() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--preset=aeneas --immediate-futures --sysroot=default --opaque=core --opaque=std --include=core::pin --monomorphize-mut=all
+pub fn view(value: std::pin::Pin<&mut u64>) -> &mut u64 { value.get_mut() }
+pub struct Shadow<'a> { pointer: &'a mut u64 }
+impl<'a> Shadow<'a> { pub fn get_mut(self) -> &'a mut u64 { self.pointer } }
+fn main() {}
+"#,
+    )?;
+    let getters: Vec<_> = data
+        .fun_decls
+        .iter()
+        .filter(|decl| {
+            let name = decl.item_meta.name.debug_repr(&data);
+            name.ends_with("::get_mut")
+                && (name.starts_with("core::pin::") || name.starts_with("test_crate::"))
+        })
+        .collect();
+    assert_eq!(getters.len(), 2);
+    for getter in getters {
+        let Body::Structured(body) = &getter.body else {
+            panic!("getter body");
+        };
+        let assignments: Vec<_> = body
+            .body
+            .statements
+            .iter()
+            .filter_map(|statement| {
+                if let StatementKind::Assign(_, value) = &statement.kind {
+                    Some(value)
+                } else {
+                    None
+                }
+            })
+            .collect();
+        if getter
+            .item_meta
+            .name
+            .debug_repr(&data)
+            .starts_with("core::pin::")
+        {
+            let [Rvalue::Use(Operand::Move(_), _)] = assignments.as_slice() else {
+                panic!("one transfer: {assignments:?}");
+            };
+        } else {
+            assert!(assignments.iter().any(|value| matches!(
+                value,
+                Rvalue::Ref {
+                    kind: BorrowKind::Mut,
+                    ..
+                }
+            )));
+        }
+    }
+    Ok(())
+}
