+    /// Reproduce the standard pin! helper only at its compiler macro expansion.
+    /// Ordinary unsafe helper calls retain their original verification boundary.
+    fn normalize_pin_macro_calls(&self, body: &mut mir::Body<'tcx>) {
+        if !self.options.immediate_futures {
+            return;
+        }
+        let tcx = self.tcx;
+        let Some(macro_id) = tcx.get_diagnostic_item(Symbol::intern("pin_macro")) else {
+            return;
+        };
+        let Some(wrapper_id) = tcx.get_diagnostic_item(Symbol::intern("PinMacroHelper")) else {
+            return;
+        };
+        let pin_id = tcx.lang_items().pin_type().unwrap();
+        for block in body.basic_blocks.as_mut() {
+            let terminator = block.terminator.as_mut().unwrap();
+            let mir::TerminatorKind::Call {
+                func,
+                args,
+                destination,
+                target: Some(target),
+                ..
+            } = &terminator.kind
+            else {
+                continue;
+            };
+            let ty::FnDef(id, _) = func.ty(&body.local_decls, tcx).kind() else {
+                continue;
+            };
+            if tcx.item_name(*id).as_str() != "pin_new_unchecked_in_helper"
+                || tcx.parent(*id) != tcx.parent(wrapper_id)
+                || args.len() != 1
+                || !terminator
+                    .source_info
+                    .span
+                    .macro_backtrace()
+                    .any(|expn| expn.macro_def_id == Some(macro_id))
+            {
+                continue;
+            }
+            let pointer = args[0].node.ty(&body.local_decls, tcx);
+            let ty::Ref(_, wrapper_ty, rustc_hir::Mutability::Mut) = pointer.kind() else {
+                continue;
+            };
+            let ty::Adt(wrapper, wrapper_args) = wrapper_ty.kind() else {
+                continue;
+            };
+            if wrapper.did() != wrapper_id
+                || wrapper.variants().len() != 1
+                || wrapper.non_enum_variant().fields.len() != 1
+            {
+                continue;
+            }
+            let payload = wrapper.non_enum_variant().fields[rustc_abi::FieldIdx::from_usize(0)]
+                .ty(tcx, wrapper_args)
+                .skip_normalization();
+            let ty::Adt(pin, pin_args) = destination.ty(&body.local_decls, tcx).ty.kind() else {
+                continue;
+            };
+            if pin.did() != pin_id {
+                continue;
+            }
+            let output_pointer = pin_args.type_at(0);
+            let ty::Ref(region, pointee, rustc_hir::Mutability::Mut) = output_pointer.kind() else {
+                continue;
+            };
+            if *pointee != payload {
+                continue;
+            }
+            let implementation = tcx.optimized_mir(*id);
+            if implementation.arg_count != 1 || implementation.basic_blocks.len() != 1 {
+                continue;
+            }
+            let entry = &implementation.basic_blocks[mir::START_BLOCK];
+            if !matches!(entry.terminator().kind, mir::TerminatorKind::Return) {
+                continue;
+            }
+            let statements = Self::pin_body_statements(entry);
+            let [borrow, construct] = statements.as_slice() else {
+                continue;
+            };
+            let mir::StatementKind::Assign((
+                borrow_dest,
+                mir::Rvalue::Ref(_, mir::BorrowKind::Mut { .. }, source),
+            )) = &borrow.kind
+            else {
+                continue;
+            };
+            if !borrow_dest.projection.is_empty()
+                || borrow_dest.local.as_usize() <= 1
+                || source.local.as_usize() != 1
+                || !matches!(source.projection.as_ref(),
+                    [mir::ProjectionElem::Deref, mir::ProjectionElem::Field(field, _)] if field.as_usize() == 0)
+            {
+                continue;
+            }
+            if !self.pin_returns_argument(construct, implementation, borrow_dest.local) {
+                continue;
+            }
+            let place = match &args[0].node {
+                mir::Operand::Move(place) | mir::Operand::Copy(place) => *place,
+                _ => continue,
+            };
+            let projected = place.project_deeper(
+                &[
+                    mir::ProjectionElem::Deref,
+                    mir::ProjectionElem::Field(rustc_abi::FieldIdx::from_usize(0), payload),
+                ],
+                tcx,
+            );
+            block.statements.extend(self.pin_reborrow_statements(
+                &mut body.local_decls,
+                terminator.source_info,
+                *destination,
+                projected,
+                pin_args,
+                *region,
+            ));
+            terminator.kind = mir::TerminatorKind::Goto { target: *target };
+        }
+    }
