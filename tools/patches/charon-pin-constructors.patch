+    /// Inline standard Pin constructors on mutable Unpin references after
+    /// checking that the compiler body only packs that reference. The caller
+    /// supplies the unchecked constructor only when translating a coroutine.
+    fn normalize_pin_constructor_calls(
+        &self,
+        body: &mut mir::Body<'tcx>,
+        unchecked: Option<rustc_hir::def_id::DefId>,
+    ) {
+        if !self.options.immediate_futures {
+            return;
+        }
+        use crate::hax::UnderOwnerState;
+        let tcx = self.tcx;
+        let pin = tcx.lang_items().pin_type().unwrap();
+        for block in body.basic_blocks.as_mut() {
+            let terminator = block.terminator.as_mut().unwrap();
+            let mir::TerminatorKind::Call {
+                func,
+                args,
+                destination,
+                target: Some(target),
+                ..
+            } = &terminator.kind
+            else {
+                continue;
+            };
+            let ty::FnDef(id, _) = func.ty(&body.local_decls, tcx).kind() else {
+                continue;
+            };
+            if args.len() != 1 {
+                continue;
+            }
+            if let Some(constructor) = unchecked {
+                if *id != constructor {
+                    continue;
+                }
+            } else {
+                if tcx.item_name(*id).as_str() != "new"
+                    || tcx.fn_sig(*id).skip_binder().safety().is_unsafe()
+                {
+                    continue;
+                }
+                let Some(parent) = tcx.impl_of_assoc(*id) else {
+                    continue;
+                };
+                let parent_ty = tcx
+                    .type_of(parent)
+                    .instantiate_identity()
+                    .skip_normalization();
+                if !matches!(parent_ty.kind(), ty::Adt(parent, _) if parent.did() == pin) {
+                    continue;
+                }
+            }
+            let pointer = args[0].node.ty(&body.local_decls, tcx);
+            let ty::Ref(_, pointee, rustc_hir::Mutability::Mut) = pointer.kind() else {
+                continue;
+            };
+            if !pointee.is_unpin(tcx, self.hax_state.typing_env()) {
+                continue;
+            }
+            let ty::Adt(output, generics) = destination.ty(&body.local_decls, tcx).ty.kind() else {
+                continue;
+            };
+            if output.did() != pin || generics.type_at(0) != pointer {
+                continue;
+            }
+            let implementation = tcx.optimized_mir(*id);
+            if implementation.arg_count != 1 || implementation.basic_blocks.len() != 1 {
+                continue;
+            }
+            let entry = &implementation.basic_blocks[mir::START_BLOCK];
+            if !matches!(entry.terminator().kind, mir::TerminatorKind::Return) {
+                continue;
+            }
+            let statements = Self::pin_body_statements(entry);
+            let [statement] = statements.as_slice() else {
+                continue;
+            };
+            if !self.pin_returns_argument(statement, implementation, mir::Local::from_usize(1)) {
+                continue;
+            }
+            block.statements.push(self.pin_assignment(
+                terminator.source_info,
+                *destination,
+                generics,
+                args[0].node.clone(),
+            ));
+            terminator.kind = mir::TerminatorKind::Goto { target: *target };
+        }
+    }
+
+    fn pin_reborrow_statements(
+        &self,
+        local_decls: &mut rustc_index::IndexVec<mir::Local, mir::LocalDecl<'tcx>>,
+        source_info: mir::SourceInfo,
+        destination: mir::Place<'tcx>,
+        projected: mir::Place<'tcx>,
+        pin_args: ty::GenericArgsRef<'tcx>,
+        region: ty::Region<'tcx>,
+    ) -> [mir::Statement<'tcx>; 2] {
+        let fresh = local_decls.push(mir::LocalDecl::new(pin_args.type_at(0), source_info.span));
+        let borrow = mir::Statement::new(
+            source_info,
+            mir::StatementKind::Assign(Box::new((
+                mir::Place::from(fresh),
+                mir::Rvalue::Ref(
+                    region,
+                    mir::BorrowKind::Mut {
+                        kind: mir::MutBorrowKind::Default,
+                    },
+                    projected,
+                ),
+            ))),
+        );
+        let construct = self.pin_assignment(
+            source_info,
+            destination,
+            pin_args,
+            mir::Operand::Move(mir::Place::from(fresh)),
+        );
+        [borrow, construct]
+    }
