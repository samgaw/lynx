+(* Connect a refreshed symbolic value to its original borrow in one region. *)
+let symbolic_reborrow_abs ctx loop_id ~with_abs_conts source_id target_id ty
+    region : abs =
+  let owned = RegionSet.singleton region in
+  let projection sv_id : symbolic_proj = { sv_id; proj_ty = ty } in
+  let borrow : tavalue =
+    let value = AProjBorrows { proj = projection source_id; loans = [] } in
+    { value = ASymbolic (PNone, value); ty }
+  in
+  let loan : tavalue =
+    let value =
+      AProjLoans { proj = projection target_id; consumed = []; borrows = [] }
+    in
+    { value = ASymbolic (PNone, value); ty }
+  in
+  let cont =
+    if not with_abs_conts then None
+    else if ty_has_mut_borrow_for_region_in_set ctx.type_ctx.type_infos owned ty
+    then
+      let projection sv_id : esymbolic_proj = { sv_id; proj_ty = ty } in
+      let borrow : tevalue =
+        let value = EProjBorrows { proj = projection source_id; loans = [] } in
+        { value = ESymbolic (PNone, value); ty }
+      in
+      let loan : tevalue =
+        let value =
+          EProjLoans { proj = projection target_id; consumed = []; borrows = [] }
+        in
+        { value = ESymbolic (PNone, value); ty }
+      in
+      Some { output = Some borrow; input = Some loan }
+    else
+      Some
+        {
+          output = Some (mk_etuple ~borrow_proj:true []);
+          input = Some (mk_etuple ~borrow_proj:false []);
+        }
+  in
+  {
+    abs_id = ctx.fresh_abs_id ();
+    kind = (match loop_id with Some id -> Loop id | None -> WithCont);
+    can_end = true;
+    parents = AbsId.Set.empty;
+    ended_subabs = AbsLevelSet.empty;
+    regions = { owned };
+    avalues = [ borrow; loan ];
+    cont;
+  }
+
