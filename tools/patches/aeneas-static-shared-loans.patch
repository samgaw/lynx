+  (* Refreshing a shared symbolic value also duplicates its hidden static
+     borrows. Keep a projection connecting them to their original loans. *)
+  let reborrow_static (sv : symbolic_value) nsid =
+    let owned = RegionSet.singleton RStatic in
+    if ty_has_regions_in_set ctx.type_ctx.type_infos owned sv.sv_ty then
+      let ty = sv.sv_ty in
+      let borrow =
+        AProjBorrows { proj = { sv_id = sv.sv_id; proj_ty = ty }; loans = [] }
+      in
+      let loan =
+        AProjLoans
+          { proj = { sv_id = nsid; proj_ty = ty }; consumed = []; borrows = [] }
+      in
+      let cont =
+        if not with_abs_conts then None
+        else if
+          ty_has_mut_borrow_for_region_in_set ctx.type_ctx.type_infos owned ty
+        then
+          let borrow =
+            EProjBorrows
+              { proj = { sv_id = sv.sv_id; proj_ty = ty }; loans = [] }
+          in
+          let loan =
+            EProjLoans
+              {
+                proj = { sv_id = nsid; proj_ty = ty };
+                consumed = [];
+                borrows = [];
+              }
+          in
+          Some
+            {
+              output = Some { value = ESymbolic (PNone, borrow); ty };
+              input = Some { value = ESymbolic (PNone, loan); ty };
+            }
+        else
+          Some
+            {
+              output = Some (mk_etuple ~borrow_proj:true []);
+              input = Some (mk_etuple ~borrow_proj:false []);
+            }
+      in
+      let kind =
+        match loop_id with
+        | Some id -> Loop id
+        | None -> WithCont
+      in
+      fresh_absl :=
+        {
+          abs_id = ctx.fresh_abs_id ();
+          kind;
+          can_end = true;
+          parents = AbsId.Set.empty;
+          regions = { owned };
+          ended_subabs = AbsLevelSet.empty;
+          avalues =
+            List.map
+              (fun value ->
+                ({ value = ASymbolic (PNone, value); ty } : tavalue))
+              [ borrow; loan ];
+          cont;
+        }
+        :: !fresh_absl
+  in
+
