+#[test]
+fn immediate_future_state_machine() -> anyhow::Result<()> {
+    let data = translate(
+        r#"//@ charon-args=--immediate-futures --start-from=crate::ready --opaque=core --opaque=std --include=core::pin::Pin --include=core::task::poll::Poll --monomorphize-mut=all
+//@ rustc-args=--edition=2024 -Zmir-strip-debuginfo=all-locals -Zmir-enable-passes=+DeadStoreElimination-final,+SimplifyLocals-final
+        pub async fn ready(value: u64) -> u64 { value }
+        fn main() {}
+        "#,
+    )?;
+    let future = data
+        .type_decls
+        .iter()
+        .find(|decl| {
+            decl.item_meta
+                .name
+                .debug_repr(&data)
+                .starts_with("test_crate::ready::")
+        })
+        .expect("compiler future type");
+    let TypeDeclKind::Struct(fields) = &future.kind else {
+        panic!("future state must be concrete");
+    };
+    assert_eq!(
+        fields.iter().map(|f| f.name.as_str()).collect_vec(),
+        ["capture_0", "state"]
+    );
+    assert!(future.generics.is_empty());
+    assert!(future.layout.is_empty());
+    let poll = data
+        .fun_decls
+        .iter()
+        .find(|decl| decl.item_meta.name.debug_repr(&data).ends_with("::poll"))
+        .expect("compiler poll implementation");
+    assert!(matches!(poll.body, Body::Structured(_)));
+    assert!(poll.item_meta.started_from);
+    assert_eq!(poll.signature.inputs.len(), 2);
+    assert_eq!(poll.generics.regions.len(), 3);
+    Ok(())
+}
