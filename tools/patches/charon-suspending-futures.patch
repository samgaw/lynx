+    /// Recover only rustc's private Context -> NonNull -> ResumeTy -> Context round-trip.
+    /// Pointer values must not escape or be observed by any other operation.
+    fn normalize_coroutine_context(
+        &mut self,
+        def: &hax::FullDef<'tcx>,
+        body: &mut mir::Body<'tcx>,
+    ) -> Result<(), Error> {
+        use rustc_middle::mir::visit::Visitor;
+        if !self.options.suspending_futures || !matches!(def.kind(), hax::FullDefKind::Coroutine(_))
+        {
+            return Ok(());
+        }
+        let span = self.translate_span(&body.span);
+        let context = self.tcx.lang_items().get(LangItem::Context).unwrap();
+        let resume = self.tcx.lang_items().get(LangItem::ResumeTy).unwrap();
+        let nonnull = self.tcx.lang_items().get(LangItem::NonNull).unwrap();
+        let input = mir::Local::from_usize(2);
+        let input_ty = body.local_decls[input].ty;
+        let is_context_ref = |ty: ty::Ty<'tcx>| {
+            matches!(ty.kind(),
+            ty::Ref(_, inner, rustc_hir::Mutability::Mut) if matches!(inner.kind(), ty::Adt(def, _) if def.did() == context))
+        };
+        if !is_context_ref(input_ty) {
+            raise_error!(self, span, "Unexpected compiler future Context input");
+        }
+        let class = |ty: ty::Ty<'tcx>| match ty.kind() {
+            ty::Adt(def, _) if def.did() == resume => Some(0),
+            ty::Adt(def, args)
+                if def.did() == nonnull
+                    && matches!(args.type_at(0).kind(), ty::Adt(def, _) if def.did() == context) =>
+            {
+                Some(1)
+            }
+            _ => None,
+        };
+        let candidates: std::collections::HashSet<_> = body
+            .local_decls
+            .iter_enumerated()
+            .filter_map(|(id, decl)| class(decl.ty).map(|_| id))
+            .collect();
+        struct Uses<'a> {
+            candidates: &'a std::collections::HashSet<mir::Local>,
+            found: bool,
+        }
+        impl<'tcx> Visitor<'tcx> for Uses<'_> {
+            fn visit_place(
+                &mut self,
+                place: &mir::Place<'tcx>,
+                _: mir::visit::PlaceContext,
+                _: mir::Location,
+            ) {
+                self.found |= self.candidates.contains(&place.local);
+            }
+        }
+        let direct = |operand: &mir::Operand<'tcx>| match operand {
+            mir::Operand::Copy(place) | mir::Operand::Move(place)
+                if place.projection.is_empty() =>
+            {
+                Some(place.local)
+            }
+            _ => None,
+        };
+        let mut rewrites = Vec::new();
+        for (block_id, block) in body.basic_blocks.iter_enumerated() {
+            for (index, statement) in block.statements.iter().enumerate() {
+                if matches!(
+                    statement.kind,
+                    mir::StatementKind::StorageLive(_)
+                        | mir::StatementKind::StorageDead(_)
+                        | mir::StatementKind::Nop
+                ) {
+                    continue;
+                }
+                let location = mir::Location {
+                    block: block_id,
+                    statement_index: index,
+                };
+                let mut uses = Uses {
+                    candidates: &candidates,
+                    found: false,
+                };
+                uses.visit_statement(statement, location);
+                if !uses.found {
+                    continue;
+                }
+                let mir::StatementKind::Assign((dest, value)) = &statement.kind else {
+                    raise_error!(
+                        self,
+                        span,
+                        "Unsupported observation of compiler future Context storage"
+                    );
+                };
+                if !dest.projection.is_empty() {
+                    raise_error!(
+                        self,
+                        span,
+                        "Unsupported projection write into compiler Context storage"
+                    );
+                }
+                let source = match value {
+                    mir::Rvalue::Cast(mir::CastKind::Transmute, operand, _)
+                        if class(body.local_decls[dest.local].ty) == Some(1)
+                            && direct(operand) == Some(input) =>
+                    {
+                        Some(input)
+                    }
+                    mir::Rvalue::Aggregate(kind, operands)
+                        if matches!(kind.as_ref(), mir::AggregateKind::Adt(id, _, _, _, _) if *id == resume)
+                            && operands.len() == 1
+                            && class(body.local_decls[dest.local].ty) == Some(0) =>
+                    {
+                        direct(&operands[rustc_abi::FieldIdx::from_usize(0)])
+                            .filter(|id| class(body.local_decls[*id].ty) == Some(1))
+                    }
+                    mir::Rvalue::Use(operand, _)
+                        if class(body.local_decls[dest.local].ty) == Some(0) =>
+                    {
+                        direct(operand).filter(|id| class(body.local_decls[*id].ty) == Some(0))
+                    }
+                    mir::Rvalue::Cast(
+                        mir::CastKind::Transmute,
+                        mir::Operand::Copy(place) | mir::Operand::Move(place),
+                        _,
+                    ) if is_context_ref(body.local_decls[dest.local].ty)
+                        && class(body.local_decls[place.local].ty) == Some(0)
+                        && matches!(place.projection.as_ref(), [mir::ProjectionElem::Field(field, _)] if field.as_usize() == 0) =>
+                    {
+                        Some(place.local)
+                    }
+                    _ => None,
+                };
+                let Some(source) = source else {
+                    raise_error!(
+                        self,
+                        span,
+                        "Unsupported use of compiler future Context pointer round-trip"
+                    );
+                };
+                rewrites.push((block_id, index, source));
+            }
+            let mut uses = Uses {
+                candidates: &candidates,
+                found: false,
+            };
+            uses.visit_terminator(
+                block.terminator(),
+                mir::Location {
+                    block: block_id,
+                    statement_index: block.statements.len(),
+                },
+            );
+            if uses.found {
+                raise_error!(
+                    self,
+                    span,
+                    "Compiler future Context pointer escapes a validated round-trip"
+                );
+            }
+        }
+        for id in candidates {
+            body.local_decls[id].ty = input_ty;
+        }
+        for (block, index, source) in rewrites {
+            let mir::StatementKind::Assign((_, value)) =
+                &mut body.basic_blocks.as_mut()[block].statements[index].kind
+            else {
+                unreachable!()
+            };
+            *value = mir::Rvalue::Ref(
+                self.tcx.lifetimes.re_erased,
+                mir::BorrowKind::Mut {
+                    kind: mir::MutBorrowKind::Default,
+                },
+                mir::Place::from(source).project_deeper(&[mir::ProjectionElem::Deref], self.tcx),
+            );
+        }
+        Ok(())
+    }
