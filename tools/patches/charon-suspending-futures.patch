+    /// Inline the compiler's Pin constructor only for an Unpin mutable pointee.
+    /// Check the standard implementation, rather than accepting an opaque call.
+    fn normalize_coroutine_pin(
+        &mut self,
+        def: &hax::FullDef<'tcx>,
+        body: &mut mir::Body<'tcx>,
+    ) -> Result<(), Error> {
+        if !self.options.suspending_futures || !matches!(def.kind(), hax::FullDefKind::Coroutine(_))
+        {
+            return Ok(());
+        }
+        use crate::hax::UnderOwnerState;
+        let tcx = self.tcx;
+        let pin = tcx.lang_items().pin_type().unwrap();
+        let constructor = tcx.lang_items().get(LangItem::PinNewUnchecked).unwrap();
+        let implementation = tcx.optimized_mir(constructor);
+        if implementation.basic_blocks.len() != 1 {
+            return Ok(());
+        }
+        let block = &implementation.basic_blocks[mir::START_BLOCK];
+        if !matches!(block.terminator().kind, mir::TerminatorKind::Return) {
+            return Ok(());
+        }
+        let statements: Vec<_> = block
+            .statements
+            .iter()
+            .filter(|statement| {
+                !matches!(
+                    statement.kind,
+                    mir::StatementKind::StorageLive(_)
+                        | mir::StatementKind::StorageDead(_)
+                        | mir::StatementKind::Nop
+                )
+            })
+            .collect();
+        let [statement] = statements.as_slice() else {
+            return Ok(());
+        };
+        let mir::StatementKind::Assign((dest, mir::Rvalue::Aggregate(kind, values))) =
+            &statement.kind
+        else {
+            return Ok(());
+        };
+        if dest.local != mir::RETURN_PLACE
+            || !dest.projection.is_empty()
+            || !matches!(kind.as_ref(), mir::AggregateKind::Adt(id, _, _, _, _) if *id == pin)
+            || values.len() != 1
+            || !matches!(&values[rustc_abi::FieldIdx::from_usize(0)], mir::Operand::Copy(place) | mir::Operand::Move(place)
+                if place.local.as_usize() == 1 && place.projection.is_empty())
+        {
+            return Ok(());
+        }
+        for block in body.basic_blocks.as_mut() {
+            let terminator = block.terminator.as_mut().unwrap();
+            let mir::TerminatorKind::Call {
+                func,
+                args,
+                destination,
+                target: Some(target),
+                ..
+            } = &terminator.kind
+            else {
+                continue;
+            };
+            let ty::FnDef(id, _) = func.ty(&body.local_decls, tcx).kind() else {
+                continue;
+            };
+            if *id != constructor || args.len() != 1 {
+                continue;
+            }
+            let ty::Ref(_, pointee, rustc_hir::Mutability::Mut) =
+                args[0].node.ty(&body.local_decls, tcx).kind()
+            else {
+                continue;
+            };
+            if !pointee.is_unpin(tcx, self.hax_state.typing_env()) {
+                continue;
+            }
+            let ty::Adt(def, generics) = destination.ty(&body.local_decls, tcx).ty.kind() else {
+                continue;
+            };
+            if def.did() != pin {
+                continue;
+            }
+            let source_info = terminator.source_info;
+            let mut inlined = (*statement).clone();
+            inlined.source_info = source_info;
+            inlined.kind = mir::StatementKind::Assign(Box::new((
+                *destination,
+                mir::Rvalue::Aggregate(
+                    Box::new(mir::AggregateKind::Adt(
+                        pin,
+                        rustc_abi::VariantIdx::from_usize(0),
+                        generics,
+                        None,
+                        None,
+                    )),
+                    rustc_index::IndexVec::from_raw(vec![args[0].node.clone()]),
+                ),
+            )));
+            let target = *target;
+            block.statements.push(inlined);
+            terminator.kind = mir::TerminatorKind::Goto { target };
+        }
+        Ok(())
+    }
