+    /// Inactive compiler storage is empty, never a fabricated value of its payload type.
+    fn require_saved_field(&mut self, span: Span, slot: Place, payload: Ty) -> Place {
+        let target = self.blocks.reserve_slot();
+        let kind = self.kind;
+        let failure = self
+            .blocks
+            .push(Terminator::new(span, TerminatorKind::UndefinedBehavior).into_block(kind));
+        let tref = slot.ty().as_adt().unwrap().clone();
+        let some = VariantId::new(1);
+        let data = SwitchData {
+            scrutinee: SwitchScrutinee::Discriminant(slot.clone()),
+            branches: vec![(
+                ConstantExpr::new(
+                    ConstantExprKind::Discriminant(tref, some),
+                    Ty::new(TyKind::Scalar(ScalarTy::Integer(IntegerTy::Signed(
+                        IntTy::Isize,
+                    )))),
+                ),
+                BranchId::ZERO,
+            )],
+            fallback: Some(BranchId::new(1)),
+        };
+        let mut branches = IndexVec::new();
+        branches.push(target);
+        branches.push(failure);
+        let block = BlockData {
+            statements: mem::take(&mut self.statements),
+            terminator: Terminator::new(span, TerminatorKind::Switch { data, branches }),
+            kind,
+        };
+        let previous = mem::replace(&mut self.current_block, target);
+        self.blocks.set_slot(previous, block);
+        slot.project(ProjectionElem::Field(Some(some), FieldId::ZERO), payload)
+    }
