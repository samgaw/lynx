+
+#[test]
+fn reconstructed_assertions_preserve_observable_unwind_cleanup() -> anyhow::Result<()> {
+    let crate_data = translate(
+        r#"//@ charon-args=--preset=aeneas --precise-drops --desugar-drops --start-from=test_crate::run
+        struct Flip<'a>(&'a mut bool);
+        impl Drop for Flip<'_> {
+            fn drop(&mut self) { *self.0 = !*self.0; }
+        }
+        pub fn run(value: &mut bool, accepted: bool) {
+            let _guard = Flip(value);
+            assert!(accepted);
+        }
+        "#,
+    )?;
+    let function = crate_data
+        .fun_decls
+        .iter()
+        .find(|function| function.item_meta.name.debug_repr(&crate_data) == "test_crate::run")
+        .expect("missing run implementation");
+    let body = &function.body.as_structured().expect("structured body").body;
+    let mut panics = 0;
+    body.dyn_visit_in_body(|statement: &Statement| {
+        assert!(!matches!(statement.kind, StatementKind::Assert { .. }));
+        if let StatementKind::Panic { on_unwind, .. } = &statement.kind {
+            panics += 1;
+            let mut cleanup_calls = 0;
+            on_unwind.dyn_visit_in_body(|cleanup: &Statement| {
+                if matches!(cleanup.kind, StatementKind::Call { .. }) {
+                    cleanup_calls += 1;
+                }
+            });
+            assert!(
+                cleanup_calls > 0,
+                "panic lost its destructor cleanup: {on_unwind:#?}"
+            );
+        }
+    });
+    assert_eq!(panics, 1, "expected the original guarded panic");
+    Ok(())
+}
